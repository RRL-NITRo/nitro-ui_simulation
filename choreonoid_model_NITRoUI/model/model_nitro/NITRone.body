format: ChoreonoidBody
format_version: 2.0
angle_unit: degree
name: "NITRone"
root_link: "Root"
links:
  -
    name: "Root"
    joint_name: "Root"
    joint_type: free
    # mass: 0.6
    translation: [ 0, 0, 0.1 ]
    mass: 0.3
    center_of_mass: [ 0, 0, 0 ]
    inertia: [
      0.002405, 0, 0,
      0, 0.002405, 0,
      0, 0, 0.004 ]
    elements:
      -
        type: Visual
        elements:
          -
            type: Transform
            rotation: [ 1, 0, 0, 90.0002104591 ]
            translation: [ 0.075, -0.015, 0 ]
            elements:
              -
                type: Transform
                scale: [ 0.001, 0.001, 0.001 ]
                elements:
                  -
                    type: Shape
                    appearance:
                      material:
                        diffuse: [ 0.498, 1, 0.831 ]
                    geometry:
                      type: Resource
                      uri: "package://nitro_description/meshes/simdrone.stl"
      -
        type: RangeSensor
        name: RangeSensor
        translation: [ 0, 0, 0.015 ]
        rotation: [[ 1, 0, 0, 90 ], [ 0, 1, 0, -90 ] ]
        direction: [ 1, 0, 0 ] # 正面向き
        yaw_range: 360
        yaw_step: 2
        pitch_range: 30
        pitch_step: 2
        scan_rate: 10
        max_distance: 10
        min_distance: 0.1
        showRange: false
        on: true
      
      -
        type: RateGyroSensor
        name: GyroSensor
        maxAngularVelocity: 1000.0
      -
        type: AccelerationSensor
        name: AccSensor
        max_acceleration: [ 1000.0, 1000.0, 1000.0 ]
      
      -
        type: SpotLight
        name: BackLight
        translation: [ -0.075, 0, 0.015 ]
        direction: [ -1, 0, 0 ] # 後ろ向き
        beamWidth: 36
        cutOffAngle: 40
        cutOffExponent: 6
        attenuation: [ 1, 0, 0.01 ]
      
      -
        type: SpotLight
        name: LeftLight
        translation: [ 0, 0.015, 0.015 ]
        direction: [ 0, 1, 0 ] # 左向き
        beamWidth: 36
        cutOffAngle: 40
        cutOffExponent: 6
        attenuation: [ 1, 0, 0.01 ]
      
      -
        type: SpotLight
        name: RightLight
        translation: [ 0, -0.015, 0.015 ]
        direction: [ 0, -1, 0 ] # 右向き
        beamWidth: 36
        cutOffAngle: 40
        cutOffExponent: 6
        attenuation: [ 1, 0, 0.01 ]
      
      -
        type: SpotLight
        name: UpLight
        translation: [ 0.05, 0, 0.03 ]
        direction: [ 0, 0, 1 ] 
        beamWidth: 36
        cutOffAngle: 40
        cutOffExponent: 6
        attenuation: [ 1, 0, 0.01 ]

      -
        type: SpotLight
        name: DownLight
        translation: [ 0.05, 0, -0.03 ]
        direction: [ 0, 0, -1 ] 
        beamWidth: 36
        cutOffAngle: 40
        cutOffExponent: 6
  -
    name: "link_Pan"
    parent: "Root"
    translation: [ 0.075, 0, 0.015 ]
    joint_name: "Pan_joint"
    joint_type: revolute
    joint_axis: [ 0, 0, 1 ]
    joint_id: 0
    joint_range: [ -75, 75 ]
    max_joint_velocity: 85.9437
    max_joint_effort: 30
    mass: 0.0001
    center_of_mass: [ 0, 0, 0 ]
    inertia: [
      1e-6, 0, 0,
      0, 1e-6, 0,
      0, 0, 1e-6 ]
    elements:
      -
        type: Shape
        appearance:
          material:
            diffuse: [ 0.498, 1, 0.831 ]
        geometry:
          type: Sphere
          radius: 0.015
  -
    name: "link_Tilt"
    parent: "link_Pan"
    joint_name: "Tilt_joint"
    joint_type: revolute
    joint_axis: [ 0, 1, 0 ]
    joint_id: 1
    joint_range: [ -75, 75 ]
    max_joint_velocity: 85.9437
    max_joint_effort: 30
    mass: 0.0001
    center_of_mass: [ 0, 0, 0 ]
    inertia: [
      1e-6, 0, 0,
      0, 1e-6, 0,
      0, 0, 1e-6 ]
    elements:
      -
        type: Shape
        appearance:
          material:
            diffuse: [ 0.498, 1, 0.831 ]
        geometry:
          type: Sphere
          radius: 0.015
      
      -
        type: Camera
        name: FrontCamera
        translation: [ 0.015, 0, 0 ]
        rotation: [ [ 1, 0, 0, 90 ], [ 0, 1, 0, -90 ] ]
        format: COLOR_DEPTH
        fieldOfView: 62
        width: 640
        height: 480
        frameRate: 20
        on: true
        elements:
          -
            type: Visual
            elements:
              -
                type: Shape
                appearance:
                  material:
                    diffuse: [ 0, 0, 0 ]
                geometry:
                  type: Box
                  size: [ 0.005, 0.005, 0.0001 ]
          
      -
        type: SpotLight
        name: FrontLight
        translation: [ 0.013, 0, 0.007 ]
        direction: [ 1, 0, 0 ] # 正面向き
        beamWidth: 36
        cutOffAngle: 40
        cutOffExponent: 6
        attenuation: [ 1, 0, 0.01 ]
        elements:
          -
            type: Visual
            elements:
              -
                type: Shape
                appearance:
                  material:
                    diffuse: [ 0, 0, 0 ]
                geometry:
                  type: Box
                  size: [ 0.0005, 0.0005, 0.0005 ]
  
  -
    name: "link_back"
    parent: "Root"
    translation: [ -0.075, 0, 0.015 ]
    joint_name: "Back_joint"
    joint_type: fixed
    mass: 0.0002
    center_of_mass: [ 0, 0, 0 ]
    inertia: [
      1e-6, 0, 0,
      0, 1e-6, 0,
      0, 0, 1e-6 ]
        
