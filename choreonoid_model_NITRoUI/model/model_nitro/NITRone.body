  -
    name: "ROTOR_RF"
    parent: "Root"
    translation: [ 0.037, -0.053, 0.005 ]
    joint_name: "ROTOR_RF_joint"
    joint_type: fixed
    mass: 0.03
    center_of_mass: [ 0, 0, 0 ]
    inertia: [
      1.98e-05, 0, 0,
      0, 1.98e-05, 0,
      0, 0, 3.75e-05 ]
    elements:
      -
        type: Rotor
        name: Rotor_RF
        direction: [ 0, 0, 1 ]
        symbol: false
  -
    name: "ROTOR_LF"
    parent: "Root"
    translation: [ 0.037, 0.053, 0.005 ]
    joint_name: "ROTOR_LF_joint"
    joint_type: fixed
