format: ChoreonoidBody
format_version: 2.0
angle_unit: degree
name: "nitroman"
root_link: "base_footprint"
links:
  -
    name: "base_footprint"
    joint_name: "base_footprint"
    joint_type: free
    mass: 1
    center_of_mass: [ 0, 0, 0 ]
    inertia: [
      1, 0, 0,
      0, 1, 0,
      0, 0, 1 ]
  -
    name: "base_link"
    parent: "base_footprint"
    translation: [ 0, 0, 0.088 ]
    joint_name: "plane2base"
    joint_type: fixed
    mass: 1
    center_of_mass: [ 0, 0, 0 ]
    inertia: [
      1, 0, 0,
      0, 1, 0,
      0, 0, 1 ]

  -
    name: TRACK_L
    parent: left_wheel_base
    translation: [ 0, 0, 0 ]
    jointType: fixed
    centerOfMass: [ 0, 0, 0 ]
    mass: 10.0
    inertia: [
      0.02, 0,    0,
      0,    0.02, 0,
      0,    0,    0.02 ]
    elements:
      -
        type: AGXVehicleContinuousTrackDevice
        name: TRACK_L
        sprocketNames: [ left_wheel_front ]
        rollerNames: [ left_wheel_center ]
        idlerNames: [ left_wheel_back ]
        upAxis: [ 0, 0, 1 ]
        numberOfNodes: 43
        nodeThickness: 0.007
        nodeWidth:  0.1
        nodeThickerThickness: 0.017
        useThickerNodeEvery: 2
        material: WRSCommonTracks
        nodeDistanceTension: 6.0e-4
        stabilizingHingeFrictionParameter: 1e-6
        minStabilizingHingeNormalForce: 80
        hingeCompliance: 9.0e-10
        hingeSpookDamping: 0.01
        nodesToWheelsMergeThreshold: -0.01
        nodesToWheelsSplitThreshold: -0.009
        enableMerge: true
        nodeShape: &NODE_SHAPE
          appearance:
            material:
              diffuseColor: [ 0.15, 0.15, 0.15 ]
              specularColor: [ 0.8, 0.8, 0.8 ]
              shininess: 0.02
