collisionDetection:
  excludeTreeDepth: 1
  excludeLinkGroups:
    -
      name: FingerGroup
      links: [ openarm_right_right_finger, openarm_right_left_finger,
               openarm_left_right_finger, openarm_left_left_finger ]

  excludeSelfCollisionLinks: [
    left_wheel_front, left_wheel_center, left_wheel_back,
    right_wheel_front, right_wheel_center, right_wheel_back,
    left_front_wheel_front, left_front_wheel_center, left_front_wheel_back,
    right_front_wheel_front, right_front_wheel_center, right_front_wheel_back,
    left_rear_wheel_front, left_rear_wheel_center, left_rear_wheel_back,
    right_rear_wheel_front, right_rear_wheel_center, right_rear_wheel_back ]
  
  excludeLinksWireCollision: [
    left_wheel_front, left_wheel_center, left_wheel_back,
    right_wheel_front, right_wheel_center, right_wheel_back,
    left_front_wheel_front, left_front_wheel_center, left_front_wheel_back,
    right_front_wheel_front, right_front_wheel_center, right_front_wheel_back,
    left_rear_wheel_front, left_rear_wheel_center, left_rear_wheel_back,
    right_rear_wheel_front, right_rear_wheel_center, right_rear_wheel_back,
    openarm_right_right_finger, openarm_right_left_finger,
    openarm_left_right_finger, openarm_left_left_finger,
    openarm_left_right_finger_pad, openarm_left_left_finger_pad, openarm_right_right_finger_pad, openarm_right_left_finger_pad,
    openarm_right_hand, openarm_left_hand, openarm_right_link7 , openarm_left_link7 ]
  excludeLinksDynamic: [ WIRE_GUARD_L, WIRE_GUARD_R, WIRE_GUARD_LF, WIRE_GUARD_RF, WIRE_GUARD_LR, WIRE_GUARD_RR ]
