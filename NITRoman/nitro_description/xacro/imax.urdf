  <joint name="base2arm_base" type="fixed">
    <parent link="main_body"/>
    <child link="arm_base"/>
    <origin rpy="0 0 0" xyz="0.159 0 0.19"/>
  </joint>
  <link name="arm_base"/>
  <!--LR: left or right-->
  <joint name="2table" type="fixed">
    <parent link="arm_base"/>
    <child link="link_base"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <joint name="yaw_joint" type="revolute">
    <parent link="arm_base"/>
    <child link="link_yaw"/>
    <limit effort="100" lower="-3.141592653589793" upper="3.141592653589793" velocity="1.5"/>
    <axis xyz="0 0 1"/>
    <origin rpy="0 0 0" xyz="0 0 0.033"/>
  </joint>
  <joint name="first_link_joint" type="revolute">
    <parent link="link_yaw"/>
    <child link="link_first_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" lower="0" upper="3.141592653589793" velocity="1.5"/>
    <origin rpy="0 0 0" xyz="0 0 0.033"/>
  </joint>
  <joint name="second_link_joint" type="revolute">
    <parent link="link_first_link"/>
    <child link="link_second_link"/>
    <axis xyz="0 -1 0"/>
    <limit effort="100" lower="0" upper="3.141592653589793" velocity="1.5"/>
    <!-- <origin xyz="${-0.001*599} 0 ${0.0577}" rpy="0 0 0" /> -->
    <origin rpy="0 0 0" xyz="-0.4 0 0"/>
  </joint>
  <joint name="third_link_joint" type="revolute">
    <parent link="link_second_link"/>
    <child link="link3_roll"/>
    <axis xyz="1 0 0"/>
    <limit effort="100" lower="-2.9670597283903604" upper="2.9670597283903604" velocity="1.5"/>
    <origin rpy="0 0 0" xyz="0.069 0 0.06"/>
  </joint>
  <joint name="hand_pitch" type="revolute">
    <parent link="link3_roll"/>
    <child link="link_hand_pitch"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" lower="-2.356194490192345" upper="2.356194490192345" velocity="1.5"/>
