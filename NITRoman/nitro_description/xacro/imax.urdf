  </gazebo>
  <gazebo reference="link_hand_base">
    <material>Gazebo/Red</material>
  </gazebo>
  <transmission name="trans_yaw_joint">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="yaw_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="yaw_joint_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="trans_first_link">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="first_link_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="first_link_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="trans_second_link">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="second_link_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="second_link_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="trans_third_link">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="third_link_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="third_link_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="trans_hand_pitch">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="hand_pitch">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="hand_pitch_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="trans_hand_roll">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="hand_roll">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="hand_roll_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <material name="hands_colors">
    <color rgba="0.2 0.211 0.192 1.0"/>
  </material>
  <!-- Base Link -->
  <link name="gripper_center"/>
  <joint name="gripper_joint" type="fixed">
    <parent link="link_hand_roll"/>
    <child link="gripper_center"/>
    <origin rpy="0 0 0" xyz="0.14 0 0"/>
    <!-- 基準位置 -->
    <axis xyz="1 0 0"/>
    <!-- x軸に沿ってスライド -->
    <limit effort="10.0" lower="0" upper="0.05" velocity="0.1"/>
    <!-- 指のスライド範囲と制限 -->
  </joint>
  <!-- Left Finger Link -->
  <link name="left_finger">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.065 0.015 0.048"/>
        <!-- 左側のフィンガー -->
      </geometry>
      <material name="hands_colors"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.065 0.015 0.048"/>
        <!-- 右側のフィンガー -->
      </geometry>
    </collision>
  </link>
  <!-- Right Finger Link -->
  <link name="right_finger">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.065 0.015 0.048"/>
        <!-- 右側のフィンガー -->
      </geometry>
      <material name="hands_colors"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.065 0.015 0.048"/>
        <!-- 右側のフィンガー -->
      </geometry>
    </collision>
  </link>
  <!-- Joint for Left Finger -->
  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_center"/>
    <child link="left_finger"/>
    <origin rpy="0 0 0" xyz="0 0.0075 0"/>
    <!-- 基準位置 -->
    <axis xyz="0 1 0"/>
    <!-- x軸に沿ってスライド -->
    <limit effort="10.0" lower="0" upper="0.05" velocity="0.1"/>
    <!-- 指のスライド範囲と制限 -->
  </joint>
  <!-- Joint for Right Finger -->
  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_center"/>
    <child link="right_finger"/>
    <origin rpy="0 0 0" xyz="0 -0.0075 0"/>
    <!-- 基準位置 -->
    <axis xyz="0 -1 0"/>
    <!-- x軸の反対方向にスライド -->
    <limit effort="10.0" lower="0" upper="0.05" velocity="0.1"/>
    <!-- 指のスライド範囲と制限 -->
  </joint>
  <!-- ROS Control for Left Finger -->
  <transmission name="left_finger_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_finger_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_finger_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <!-- ROS Control for Right Finger -->
  <transmission name="right_finger_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_finger_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_finger_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
