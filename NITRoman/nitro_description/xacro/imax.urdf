  <joint name="front_fisheye_joint" type="fixed">
    <parent link="link_hand_roll"/>
    <child link="front_fisheye"/>
    <axis xyz="1 0 0"/>
    <origin rpy="0 0.7853981633974483 0" xyz="0.08 0 0.15"/>
  </joint>
  <link name="front_fisheye">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="back_fisheye_joint" type="fixed">
    <parent link="link_second_link"/>
    <child link="back_fisheye"/>
    <axis xyz="1 0 0"/>
    <origin rpy="0 -0.7853981633974483 0" xyz="-0.04 0 0.15"/>
  </joint>
  <link name="back_fisheye">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <link name="livox_frame_front"/>
  <link name="cnoid_livox_frame_front"/>
  <joint name="livox_base_joint" type="fixed">
    <parent link="main_body"/>
    <child link="livox_frame_front"/>
    <limit effort="10000.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="0.5"/>
    <origin rpy="0 -0.3316125578789226  3.14159" xyz="0.2 0 0.08"/>
  </joint>
  <joint name="cnoid_livox_base_joint" type="fixed">
    <parent link="livox_frame_front"/>
    <child link="cnoid_livox_frame_front"/>
    <limit effort="10000.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="0.5"/>
    <origin rpy="-1.5707963267948966 0 0" xyz="0 0 0"/>
  </joint>
  <link name="imu_frame"/>
  <joint name="imu_joint" type="fixed">
    <parent link="main_body"/>
    <child link="imu_frame"/>
    <limit effort="10000.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="0.5"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <gazebo>
    <plugin filename="libgazebo_ros_control.so" name="gazebo_ros_control">
      <robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType>
      <legacyModeNS>false</legacyModeNS>
    </plugin>
  </gazebo>
</robot>
