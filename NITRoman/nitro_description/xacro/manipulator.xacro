<?xml version="1.0" encoding="UTF-8"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro" />
  <xacro:include filename="$(find nitro_description)/xacro/top_finger.xacro" />
  <material name="table_colors">
    <!-- <color rgba="0.121 0.192 0.203 1.0" /> -->
    <color rgba="0.1 0.2 0.3 1.0" /> 
  </material>

  <material name="gear_colors">
    <color rgba="0.121 0.192 0.203 1.0" />
  </material>

  <material name="link_colors">
    <color rgba="0.17 0.662 0.882 1.0" />
  </material>

  <!--main body belt-->
  <xacro:macro name="main_frame" params="parent">
    <!--LR: left or right-->

    <joint name="2table" type="fixed">
      <parent link="${parent}" />
      <child link="link_base" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>
    <joint name="yaw_joint" type="revolute">
      <parent link="${parent}" />
      <child link="link_yaw" />
      <limit effort="100" lower="${-pi}" upper="${pi}" velocity="1.5" />
      <axis xyz="0 0 1" />
      <origin xyz="0 0 ${0.001*33}" rpy="0 0 0" />
    </joint>

    <joint name="first_link_joint" type="revolute">
      <parent link="link_yaw" />
      <child link="link_first_link" />
      <axis xyz="0 1 0"/>
      <limit effort="100" lower="0" upper="${pi}" velocity="1.5" />
      <origin xyz="0 0 ${0.001*33}" rpy="0 0 0" />
    </joint>

    <joint name="second_link_joint" type="revolute">
      <parent link="link_first_link" />
      <child link="link_second_link" />
      <axis xyz="0 -1 0" />
      <limit effort="100" lower="0" upper="${pi}" velocity="1.5" />
      <!-- <origin xyz="${-0.001*599} 0 ${0.0577}" rpy="0 0 0" /> -->
       <origin xyz="${-0.001*400} 0 0" rpy="0 0 0" />
    </joint>

    <joint name="third_link_joint" type="revolute">
      <parent link="link_second_link"/>
      <child link="link3_roll"/>
      <axis xyz="1 0 0" />
      <limit effort="100" lower="${-pi+pi/18}" upper="${pi-pi/18}" velocity="1.5" />
      <origin xyz="${0.001*69} 0 ${0.001*60}" rpy="0 0 0"/>
    </joint>

    <joint name="hand_pitch" type="revolute">
      <parent link="link3_roll" />
      <child link="link_hand_pitch" />
      <axis xyz="0 1 0" />
      <limit effort="100" lower="${-pi*3/4}" upper="${pi*3/4}" velocity="1.5" />
      <origin xyz="${0.001*331} 0 0" rpy="0 0 0"/>
    </joint>

    <joint name="hand_roll" type="revolute">
      <parent link="link_hand_pitch" />
      <child link="link_hand_roll" />
      <axis xyz="1 0 0" />
      <limit effort="10" lower="${-pi/2}" upper="${pi/2}" velocity="0.5" />
      <origin xyz="${0.001*62.25} 0 0" rpy="0 0 0" />
    </joint>
    <!-- <joint name="hand_roll" type="revolute">
      <parent link="link_hand_yaw" />
      <child link="link_hand_roll" />
      <axis xyz="1 0 0" />
      <limit effort="100" lower="${-pi}" upper="${pi}" velocity="0.5" />
      <origin xyz="${0.001*32.5} 0 ${-0.001*0.5}" rpy="0 0 0" />
    </joint> -->

    <link name="link_base">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0.0" iyz="0" ixz="0"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <mesh filename="package://nitro_description/meshes/man/STL/arm_base.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="table_colors"/>
      </visual>
       <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <mesh filename="package://nitro_description/meshes/man/STL/arm_base.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="link_yaw">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.5"/>
        <inertia ixx="0.0666" iyy="0.0024166" izz="0.0024166" ixy="0.0" iyz="0" ixz="0"/>
      </inertial>
      <visual>
       <origin xyz="0 0 0" rpy="${pi/2} 0 ${pi/2}"/>
        <geometry>
          <mesh filename="package://nitro_description/meshes/man/STL/yaw_link.stl"
            scale="0.001 0.001 0.001" />
        </geometry>
        <material name="table_colors"/>
      </visual>
        <collision name="cylinder_collision">
          <geometry>
            <cylinder length="0.001" radius="0.01" />
          </geometry>
        </collision>
    </link>

    <link name="link_first_link">
      <inertial>
        <origin xyz="-0.2 -0.025 0" rpy="0 0 0"/>
        <mass value="1.6"/>
        <inertia ixx="0.003213" iyy="0.0165" izz="0.019333" ixy="0.0" iyz="0" ixz="0"/>        
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
        
          <mesh filename="package://nitro_description/meshes/man/STL/link1_arm.stl"
            scale="0.001 0.001 0.001" />
        </geometry>
        <material name="table_colors"/>
      </visual>
      <collision>
        <origin xyz="-0.2 -0.025 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.35 0.15 0.04" />
        </geometry>
      </collision>
    </link>

    <link name="link_second_link">
      <inertial>
        <origin xyz="0.0 -0.025 0.02" rpy="0 0 0"/>
        <mass value="1.3"/>
        <inertia ixx="0.00216" iyy="0.00147" izz="0.00147" ixy="0.0" iyz="0" ixz="0"/>        
      </inertial>
      <visual>
        <origin rpy="${pi/2} ${pi} 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://nitro_description/meshes/man/STL/arm_link3.stl"
            scale="0.001 0.001 0.001" />
        </geometry>
        <material name="table_colors"/>
      </visual>
      <collision>
        <origin xyz="0.0 -0.025 0.02" rpy="0 0 0"/>
        <geometry>
          <box size="0.06 0.1 0.1" />
        </geometry>
      </collision>
    </link>

    <link name="link3_roll">
      <inertial>
        <origin xyz="0.15 0 0" rpy="0 0 0"/>
        <mass value="0.6"/>
        <inertia ixx="0.00025" iyy="0.00325" izz="0.00325" ixy="0.0" iyz="0" ixz="0"/>        
      </inertial>
      <visual>
        <origin rpy="${pi/2} ${pi} ${-pi/2}" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://nitro_description/meshes/man/STL/roll1link.stl"
            scale="0.001 0.001 0.001" />
        </geometry>
        <material name="table_colors"/>
      </visual>
      <collision>
        <origin xyz="0.15 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.25 0.05 0.05" />
        </geometry>
      </collision>
    </link>

    <link name="link_hand_pitch">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.00014" iyy="0.00029" izz="0.00016" ixy="0.0" iyz="0" ixz="0"/>        
      </inertial>
      <visual>
        <origin xyz=" 0 0 0" rpy="${-pi/2} ${pi} ${pi/2}"/>
        <geometry>
          <mesh filename="package://nitro_description/meshes/man/STL/pitch.stl"
            scale="0.001 0.001 0.001" />
        </geometry>
        <material name="table_colors"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.08 0.03 0.02" />
        </geometry>
      </collision>
    </link>

    <link name="link_hand_roll">
      <inertial>
        <origin xyz="0.03 0 0" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" iyz="0" ixz="0"/>        
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://nitro_description/meshes/man/STL/end_roll_full.stl"
            scale="0.001 0.001 0.001" />
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="table_colors"/>
      </visual>
      <collision>
        <origin xyz="0.03 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.1 0.05" />
        </geometry>
      </collision>
    </link>

    <!-- <link name="link_hand_">
      <inertial>
        <origin xyz="0.025 0 0" rpy="0 0 0"/>
        <mass value="0.8"/>
        <inertia ixx="0.00052" iyy="0.00104" izz="0.00108" ixy="0.0" iyz="0" ixz="0"/>        
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://nitro_description/meshes/man/STL/.stl"
            scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.05 0 0" rpy="0 0 0"/>
        <geometry>
        </geometry>
      </collision>
    </link> -->

    <gazebo reference="arm_base">
      <material>Gazebo/Red</material>
    </gazebo> 
    <gazebo reference="2table">
      <material>Gazebo/Red</material>
    </gazebo> 
    <gazebo reference="link_turn">
      <material>Gazebo/Red</material>
    </gazebo> 
    <gazebo reference="link_hand_roll">
      <material>Gazebo/Red</material>
    </gazebo> 
    <gazebo reference="link_first_link">
      <material>Gazebo/Red</material>
    </gazebo> 
    <gazebo reference="link_second_link">
      <material>Gazebo/Red</material>
    </gazebo> 
    <gazebo reference="link3_roll">
      <material>Gazebo/Red</material>
    </gazebo> 
    <gazebo reference="link_hand_base">
      <material>Gazebo/Red</material>
    </gazebo> 
  
    <transmission name="trans_yaw_joint">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="yaw_joint">
          <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="yaw_joint_motor">
          <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
          <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="trans_first_link">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="first_link_joint">
          <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="first_link_motor">
          <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
          <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="trans_second_link">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="second_link_joint">
          <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="second_link_motor">
          <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
          <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="trans_third_link">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="third_link_joint">
          <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="third_link_motor">
          <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
          <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="trans_hand_pitch">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="hand_pitch">
          <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="hand_pitch_motor">
          <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
          <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="trans_hand_roll">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="hand_roll">
          <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="hand_roll_motor">
          <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
          <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <xacro:gripper parent="link_hand_roll"/>

  </xacro:macro>

  <!-- <xacro:sensor_d435 parent="link_second_link" name="d435/camera" use_nominal_extrinsics="true">
      <origin xyz="${0.01*18} 0 ${0.01*5}" rpy="0 0 0" />-->
  <!-- <xacro:sensor_d435 parent="link_hand_roll" name="camera" use_nominal_extrinsics="true">
    <origin xyz="${0.001*17.15} 0 ${0.001*27.85}" rpy="0 0 0" />
  </xacro:sensor_d435> -->

</robot>
