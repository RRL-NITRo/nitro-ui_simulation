<?xml version="1.0" encoding="UTF-8"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">


  <xacro:include filename="$(find nitro_description)/xacro/macros/common.xacro"/>

  <!-- カーボンの密度 (kg/m³) -->
  <xacro:property name="carbon_density" value="1750"/>

  <!-- マクロ: 円柱のイナーシャと質量を自動計算 -->
  <xacro:macro name="calc_inertia_cylinder" params="radius length">
    <!-- 体積の計算 -->
    <xacro:property name="volume" value="${pi * radius * radius * length}"/>
    
    <!-- 質量の計算 (密度 * 体積) -->
    <xacro:property name="mass" value="${carbon_density * volume}"/>
    
    <!-- イナーシャの計算 -->
    <xacro:property name="inertia_ixx_iyy" value="${(1/12.0) * mass * (3 * radius * radius + length * length)}"/>
    <xacro:property name="inertia_izz" value="${(1/2.0) * mass * radius * radius}"/>
    
    <!-- Inertial要素 -->
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="${inertia_ixx_iyy}" ixy="0" ixz="0" iyy="${inertia_ixx_iyy}" iyz="0" izz="${inertia_izz}"/>
    </inertial>
  </xacro:macro>

  <!-- クローラーのマクロ -->
  <xacro:macro name="make_wheel" params="length width radius parent name offset_y offset_x axis">
    <!-- 中心ジョイント -->
    <joint name="${name}_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child  link="${name}_base"/>
      <origin xyz="${offset_x} ${offset_y} 0" rpy="0 0 0"/>
    </joint>

    <!-- 前側ジョイント -->
    <joint name="${name}_front_joint" type="revolute">
      <parent link="${name}_base"/>
      <child  link="${name}_front"/>
      <origin xyz="${length/2} 0 0" rpy="0 0 0"/>
      <limit effort="1000" velocity="100" upper="100" lower="-100"/>
      <axis xyz="0 ${axis} 0"/>
    </joint>

        <!-- ジョイント -->
        <joint name="${name}_center_joint" type="revolute">
          <parent link="${name}_base"/>
          <child  link="${name}_center"/>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <limit effort="1000" velocity="100" upper="100" lower="-100"/>
          <axis xyz="0 ${axis} 0"/>
        </joint>

    <!-- 後側ジョイント -->
    <joint name="${name}_back_joint" type="revolute">
      <parent link="${name}_base"/>
      <child  link="${name}_back"/>
      <origin xyz="-${length/2} 0 0" rpy="0 0 0"/>
      <limit effort="1000" velocity="100" upper="100" lower="-100"/>
      <axis xyz="0 ${axis} 0"/>
    </joint>

    <!-- 親リンクの定義 -->
    <link name="${name}_base">
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" iyz="0" ixz="0"/>   
    </link>

    <!-- 前側リンク -->
    <link name="${name}_front">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${width}"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${width}"/>
        </geometry>
      </collision>
      <xacro:calc_inertia_cylinder radius="${radius}" length="${width}"/>
    </link>

    <!-- 後側リンク -->
    <link name="${name}_back">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${width}"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${width}"/>
        </geometry>
      </collision>
      <xacro:calc_inertia_cylinder radius="${radius}" length="${width}"/>
    </link>

    <link name="${name}_center">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${width}"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${width}"/>
        </geometry>
      </collision>
      <xacro:calc_inertia_cylinder radius="${radius}" length="${width}"/>
    </link>


    <!-- ジョイントのトランスミッション -->
    <xacro:joint_velocity_trans_v0 name="${name}_front_joint"/>
    <xacro:joint_velocity_trans_v0 name="${name}_back_joint"/>
    <xacro:joint_velocity_trans_v0 name="${name}_center_joint"/>
  </xacro:macro>
</robot>
