<?xml version="1.0" encoding="UTF-8"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

<xacro:macro name="sensors">

<joint name="camera_joint" type="fixed">
    <parent link="link_hand_roll" />
    <child link="camera_link" />
    <axis xyz="1 0 0" />
    <origin xyz="${0.001*18} 0 ${0.01*5}" rpy="0 0 0" />
  </joint>

  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" iyz="0" ixz="0"/>        
    </inertial>
  </link>

  <joint name="cnoid_camera_joint" type="fixed">
    <parent link="camera_link" />
    <child link="cnoid_d435" />
    <axis xyz="1 0 0" />
    <origin xyz="0 0 0" rpy="${pi/2} 0 ${-pi/2}" />
  </joint>

  <link name="cnoid_d435">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" iyz="0" ixz="0"/>        
    </inertial>
  </link>

  <joint name="front_fisheye_joint" type="fixed">
    <parent link="link_hand_roll" />
    <child link="front_fisheye" />
    <axis xyz="1 0 0" />
    <origin xyz="${0.01*8} 0 ${0.01*15}" rpy="0 ${pi/4} 0" />
  </joint>

  <link name="front_fisheye">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" iyz="0" ixz="0"/>        
    </inertial>
  </link>

  <joint name="back_fisheye_joint" type="fixed">
    <parent link="link_second_link" />
    <child link="back_fisheye" />
    <axis xyz="1 0 0" />
    <origin xyz="${-0.01*4} 0 ${0.01*15}" rpy="0 ${-pi/4} 0" />
  </joint>

  <link name="back_fisheye">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" iyz="0" ixz="0"/>        
    </inertial>
  </link>

  <link name="livox_frame_front"/>
  <link name="cnoid_livox_frame_front"/>
  <joint name="livox_base_joint" type="fixed">
       <parent link="main_body"/>
       <child  link="livox_frame_front"/>
 <limit effort="10000.0" lower="${-pi}" upper="${pi}" velocity="0.5"/>
       <origin xyz="0.2 0 0.08" rpy="0 ${-19*pi/180}  3.14159"/>
     </joint>
     <joint name="cnoid_livox_base_joint" type="fixed">
      <parent link="livox_frame_front"/>
      <child  link="cnoid_livox_frame_front"/>
<limit effort="10000.0" lower="${-pi}" upper="${pi}" velocity="0.5"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
    </joint>
  <link name="imu_frame"/>
    <joint name="imu_joint" type="fixed">
       <parent link="main_body"/>
       <child  link="imu_frame"/>
 <limit effort="10000.0" lower="${-pi}" upper="${pi}" velocity="0.5"/>
       <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>

</xacro:macro> 
</robot>