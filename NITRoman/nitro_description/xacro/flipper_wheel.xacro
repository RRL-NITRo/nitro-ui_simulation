<?xml version="1.0" encoding="UTF-8"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <material name="flipper_colors">
    <color rgba="0.6 0.6 0.6 1"/>
  </material>
  <material name="flipper_belt_colors">
    <color rgba="0.6 0.6 0.6 1"/>
  </material>

 <!--flipper depiction-->
 <xacro:macro name="flipper_wheel" params="LR FR parent">
    <!--LR: left or right, FR: front or rear-->
    <xacro:if value="${FR=='front'}">
      <xacro:property name="fr" value="1"/>
      <xacro:property name="fr_yaw" value="0.001"/>
      <xacro:property name="fr_ax" value="1"/>
   
    </xacro:if>
    <xacro:if value="${FR=='rear'}">
      <xacro:property name="fr" value="0"/>
      <xacro:property name="fr_yaw" value="-0.001"/>
      <xacro:property name="fr_ax" value="-1"/>
    </xacro:if>
    <xacro:if value="${LR=='left'}">
      <xacro:property name="lr" value="0.001"/>
      <xacro:property name="lr_ax" value="1"/>
    </xacro:if>
    <xacro:if value="${LR=='right'}">
      <xacro:property name="lr" value="-0.001"/>
      <xacro:property name="lr_ax" value="-1"/>
    </xacro:if>
    <xacro:if value="${LR=='left'}">
      <xacro:property name="fli_row" value="1"/>
    </xacro:if>
    <xacro:if value="${LR=='right'}">
      <xacro:property name="fli_row" value="0"/>
    </xacro:if>
    <xacro:property name="body_length_flip" value="0.29"/>
    <xacro:property name="body_width_flip" value="0.244"/>
    <xacro:property name="body_height_flip" value="0"/>
    <xacro:property name="wheel_radius_flip" value="0.082"/>
    <xacro:property name="wheel_width_flip" value="0.025"/>


     <!--pole-->
    <joint name="joint_${LR}_${FR}" type="revolute">
      <parent link="${parent}"/>
      <child  link="${LR}_${FR}"/>
      <axis xyz="0 ${fr_ax*lr_ax} 0"/>
      <limit effort="10000" lower="${-pi}" upper="${pi}" velocity="1"/>
      <origin xyz="${225*fr_yaw} ${184*lr} ${0*0.001}" rpy="${pi*fli_row} ${pi*(fr-1)} ${pi}"/>
    </joint>


     <!--belt-->
     <!--<joint name="${LR}_${FR}2flipper_belt" type="fixed">
      <parent link="${LR}_${FR}"/>
      <child  link="flipper_belt_${LR}_${FR}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    -->
    <link name="${LR}_${FR}">
      <material>
        <color rgba="${WHITE}" />
      </material>
      <visual>
        <geometry>
          <mesh filename="package://nitro_description/meshes/body/flipper2024_newbelt.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="flipper_colors"/>
      </visual>
      <!-- <collision>
        <geometry>
          <mesh filename="package://nitro_description/meshes/body/flipper2024_newbelt.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>-->
      <!-- <collision> 
        <origin xyz="-0.145 0.048 0" rpy="0 0 0" />
        <geometry>
          <box size="0.29 0.025 0.164" />
        </geometry>
      </collision>
  
      <collision>
        <origin xyz="0 0.048 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="0.082" length="0.025"/>
        </geometry>
      </collision>
  
      <collision>
        <origin xyz="-0.29 0.048 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="0.082" length="0.025"/>
        </geometry>
      </collision> -->

      <!-- <inertial>
        <origin xyz="-0.14 0.048 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.0030125" ixy="0.0" ixz="0.0" iyy="0.01406" iyz="0.0" izz="0.01145"/>
    </inertial> -->
    </link>

    <transmission name="trans_${LR}_${FR}">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="joint_${LR}_${FR}">
          <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="autuator_${LR}_${FR}">
          <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
          <mechanicalReduction>1</mechanicalReduction>
      </actuator>
  </transmission>

  <xacro:make_wheel offset_y="0.048" axis="${lr_ax}" offset_x="${-body_length_flip/2}" length="${body_length_flip}" width="${wheel_width_flip}" radius="${wheel_radius_flip}" parent="${LR}_${FR}" name="${LR}_${FR}_wheel">
  </xacro:make_wheel>



  </xacro:macro>
</robot>
