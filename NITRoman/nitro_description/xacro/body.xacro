<?xml version="1.0" encoding="UTF-8"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <material name="body_colors">
    <color rgba="0.6 1.0 0.6 1.0"/>
  </material>

  <xacro:include filename="$(find nitro_description)/xacro/macros/common.xacro"/>

  <xacro:macro name="main_body_newbelt" params="parent">
    <!-- <xacro:property name="val" value="1000"/> -->

    <joint name="2main_body" type="fixed">
      <parent link="base_link"/>
      <child  link="${parent}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <joint name="mainbelt_left_joint" type="revolute">
      <parent link="${parent}"/>
      <child  link="mainbelt_left"/>
      <origin xyz="0 0.122 0" rpy="0 0 0"/>
      <limit effort="1000" velocity="1.0" upper="100" lower="-100"/>
      <axis xyz="0 1 0"/>
    </joint>

    <joint name="mainbelt_right_joint" type="revolute">
      <parent link="${parent}"/>
      <child  link="mainbelt_right"/>
      <origin xyz="0 -0.122 0" rpy="0 0 0"/>
      <limit effort="1000" velocity="1.0" upper="100" lower="-100" />
      <axis xyz="0 1 0"/>
    </joint>


    <link name="${parent}">
      <visual>
        <origin xyz="0 0 0" rpy="${pi} 0 0"/>
        <geometry>
          <mesh filename="package://nitro_description/meshes/body/main_crawler.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="body_colors"/>
      </visual>
      
      <inertial>
      <mass value="33"/>
      <inertia ixx="0.42295" ixy="0.0" ixz="0.0" iyy="0.733975" iyz="0.0" izz="1.063975"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.45 0.3 0.164"/>
      </geometry>
    </collision>
    </link>
    

    <link name="mainbelt_left">

      <collision> 
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.45 0.1 0.164" />
        </geometry>
      </collision>
  
      <collision>
        <origin xyz="0.225 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="0.082" length="0.1"/>
        </geometry>
      </collision>
  
      <collision>
        <origin xyz="-0.225 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="0.082" length="0.1"/>
        </geometry>
      </collision>


    </link>
    <link name="mainbelt_right">


      <collision> 
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.45 0.1 0.164" />
        </geometry>
      </collision>
  
      <collision>
        <origin xyz="0.225 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="0.082" length="0.1"/>
        </geometry>
      </collision>
  
      <collision>
        <origin xyz="-0.225 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="0.082" length="0.1"/>
        </geometry>
      </collision>

    </link>


 

    <xacro:joint_velocity_trans_v0 name="mainbelt_left_joint"/>
    
    <xacro:joint_velocity_trans_v0 name="mainbelt_right_joint"/>
    <gazebo reference="mainbelt_left_joint">
      <material>Gazebo/Red</material>
    </gazebo>
    <gazebo reference="mainbelt_right_joint">
      <material>Gazebo/Red</material>
    </gazebo>
    
  </xacro:macro>
  
  
</robot>
